// Prisma Schema for Automated AI Call Transcription & QA Platform

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Client {
  id                    String     @id @default(cuid())
  name                  String
  code                  String     @unique
  globalPrompt          String
  qualificationCriteria String
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  campaigns             Campaign[]
}

model Campaign {
  id                             String   @id @default(cuid())
  name                           String
  code                           String   @unique
  clientCode                     String
  assetTitle                     String
  valueProps                     String   // Stored as JSON array string
  additionalEditingInstructions String
  qualificationRulesOverride    String?
  isActive                       Boolean  @default(true)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  client                         Client   @relation(fields: [clientCode], references: [code], onDelete: Cascade)
}

model CrmLead {
  id             String          @id @default(cuid())
  leadRef        String          @unique
  clientCode     String
  campaignCode   String
  contactName    String
  companyName    String
  jobTitle       String?
  email          String?
  phone          String?
  recordingUrl   String
  syncedAt       DateTime        @default(now())
  processingJobs ProcessingJob[]
}

model ProcessingJob {
  id                   String     @id @default(cuid())
  leadId               String
  leadRef              String
  status               String     @default("PENDING") // PENDING, AUDIO_RETRIEVED, TRANSCRIBING, AI_EDITING, QA_EVALUATING, COMPLETED, FAILED
  stepError            String?
  gcsAudioUri          String?
  rawTranscript        String?    // JSON string storing speaker diarization & text
  editedTranscript     String?
  promptVersionUsed    String?
  qaStatus             String?    // QUALIFIED, NEEDS_REVIEW, UNQUALIFIED
  qaResultJson         String?    // JSON string storing checklist, evidence, missing items, review reasons
  manualOverrideStatus String?    // QUALIFIED, NEEDS_REVIEW, REJECTED
  manualOverrideNotes  String?
  reviewedBy           String?
  reviewedAt           DateTime?
  attempts             Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  lead                 CrmLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  auditLogs            AuditLog[]
}

model AuditLog {
  id        String         @id @default(cuid())
  jobId     String?
  action    String
  details   String
  timestamp DateTime       @default(now())
  job       ProcessingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
}

model SystemSettings {
  id                    String   @id @default("global")
  crmEndpoint           String   @default("http://localhost:3000/api/crm/mock-server")
  crmApiKey             String   @default("crm_sec_demandarm_live_2026")
  gcsBucketName         String   @default("demandarm-call-recordings")
  gcpProjectId          String   @default("demandarm-ai-qa")
  gcpClientEmail        String   @default("")
  gcpPrivateKey         String   @default("")
  sttLanguageCode       String   @default("en-US")
  sttModel              String   @default("telephony")
  sttDiarizationEnabled Boolean  @default(true)
  geminiApiKey          String   @default("")
  geminiModel           String   @default("gemini-3.8-flash")
  maxConcurrency        Int      @default(3)
  autoSyncInterval      Int      @default(15)
  updatedAt             DateTime @updatedAt
}
