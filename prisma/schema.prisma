// Prisma Schema for Automated AI Call Transcription & QA Platform (MySQL / phpMyAdmin)

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Client {
  id                    String     @id @default(cuid())
  name                  String
  code                  String     @unique
  globalPrompt          String     @db.Text
  qualificationCriteria String     @db.Text
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  campaigns             Campaign[]
}

model Campaign {
  id                            String   @id @default(cuid())
  name                          String
  code                          String   @unique
  clientCode                    String
  assetTitle                    String
  valueProps                    String   @db.Text
  additionalEditingInstructions String   @db.Text
  qualificationRulesOverride   String?  @db.Text
  isActive                      Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  client                        Client   @relation(fields: [clientCode], references: [code], onDelete: Cascade)
}

model ClientPromptVersion {
  id                    String   @id @default(cuid())
  clientCode            String
  version               Int
  promptText            String   @db.Text
  qualificationCriteria String   @db.Text
  createdBy             String   @default("System Admin")
  createdAt             DateTime @default(now())
}

model CrmLead {
  id             String          @id @default(cuid())
  leadRef        String          @unique
  clientCode     String
  campaignCode   String
  campaignName   String?
  agentId        String?
  agentName      String?
  contactName    String
  companyName    String
  companySize    String?
  industry       String?
  country        String?
  jobTitle       String?
  email          String?
  phone          String?
  recordingUrl   String          @db.Text
  qaStatusCrm    String?
  rawLeadData    String?         @db.LongText
  syncedAt       DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  processingJobs ProcessingJob[]
}

model ProcessingJob {
  id                   String     @id @default(cuid())
  leadId               String
  leadRef              String
  status               String     @default("PENDING")
  stepError            String?    @db.Text
  gcsAudioUri          String?    @db.Text
  rawTranscript        String?    @db.LongText
  editedTranscript     String?    @db.LongText
  promptVersionUsed    String?
  qaStatus             String?
  qaResultJson         String?    @db.LongText
  manualOverrideStatus String?
  manualOverrideNotes  String?    @db.Text
  reviewedBy           String?
  reviewedAt           DateTime?
  attempts             Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  lead                 CrmLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  auditLogs            AuditLog[]
}

model AuditLog {
  id        String         @id @default(cuid())
  jobId     String?
  action    String
  details   String         @db.Text
  timestamp DateTime       @default(now())
  job       ProcessingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
}

model SystemSettings {
  id                      String   @id @default("global")
  crmEndpoint             String   @default("https://app.tarajglobal.com/demandflowbridge/api/get_leads.php")
  crmApiKey               String   @default("crm_sec_demandarm_live_2026")
  gcsBucketName           String   @default("qtranscript-recordings")
  gcpProjectId            String   @default("demandarm-ai-qa")
  gcpClientEmail          String   @default("")
  gcpPrivateKey           String   @default("") @db.Text
  sttLanguageCode         String   @default("en-US")
  sttModel                String   @default("telephony")
  sttDiarizationEnabled   Boolean  @default(true)
  geminiApiKey            String   @default("")
  geminiModel             String   @default("gemini-3.8-flash")
  geminiTemperature       Float    @default(0.2)
  geminiMaxTokens         Int      @default(4096)
  maxConcurrency          Int      @default(3)
  autoSyncInterval        Int      @default(15)
  autoGenerateTranscripts Boolean  @default(true)
  autoQaEvaluation        Boolean  @default(true)
  audioRetentionDays      Int      @default(90)
  sttCostPerMinute        Float    @default(0.016)
  geminiInputCostPer1M    Float    @default(0.075)
  geminiOutputCostPer1M   Float    @default(0.30)
  updatedAt               DateTime @updatedAt
}
